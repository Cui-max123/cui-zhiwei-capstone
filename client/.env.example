# The API base the client calls. Leave empty in local development to use the
# Vite proxy, or set an absolute URL for a production build.
#   Example: https://your-api.onrender.com/api
VITE_API_URL=

# Base path for the router. Leave empty for Vercel/Netlify; set to /<repo>/ for
# GitHub Pages (the deploy workflow sets this automatically).
VITE_BASE=

# Where `npm run dev` proxies /api requests.
VITE_DEV_API=http://localhost:5000
