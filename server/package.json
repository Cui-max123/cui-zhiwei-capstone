{
  "name": "cui-zhiwei-portfolio-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Cui Zhiwei's portfolio and blog — Express, Mongoose, JWT.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:memory": "node scripts/dev-memory.js",
    "seed": "node src/seed/run.js",
    "seed:reset": "node src/seed/run.js --reset",
    "make:admin": "node scripts/make-admin.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node --check src/server.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "nodemon": "3.1.14",
    "supertest": "7.3.1"
  }
}
