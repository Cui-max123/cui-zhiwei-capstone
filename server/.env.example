# ---------------------------------------------------------------------------
# Server configuration — copy this file to `.env` and fill in real values.
# Never commit `.env`.
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string. The database name is required.
# Example:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cui_portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/cui_portfolio?retryWrites=true&w=majority

# A long random secret. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
JWT_EXPIRES_IN=7d

# Browser origin(s) allowed to call the API. Comma-separated, no trailing slash.
# Local development:
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CLIENT_ORIGINS=https://your-name.github.io,https://your-site.vercel.app

# Set to 1 when the app runs behind one trusted proxy (Render, Railway, Vercel).
TRUST_PROXY=0

# Optional: comma-separated emails that `npm run seed` should promote to admin.
ADMIN_EMAILS=cui@cuizhiwei.dev

# Leave empty in production. Tests set this to true.
RATE_LIMIT_DISABLED=false
